RewriteEngine On

# --- Security: never serve hidden files/dirs (.git, .env, ...), dumps, backups,
# --- or source/config files. Added after probes for /.git/HEAD, /.env, *.sql, etc.
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
RewriteRule \.(sql|bak|old|swp|log|zip|tar|gz|tgz)$ - [F,L]
RewriteRule ^(includes|scss|node_modules)/ - [F,L]
RewriteRule ^(config|router)\.php$ - [F,L]
RewriteRule ^(package(-lock)?\.json|composer\.(json|lock)|README\.md|dev\.sh|serve\.sh)$ - [F,L]


RewriteRule ^northern-nevada-city-guides/?$ index.php [L]

RewriteRule ^dayton/dayton-valley/?$ dayton/dayton-valley/index.php [L]
RewriteRule ^dayton/santa-maria-ranch/?$ dayton/santa-maria-ranch/index.php [L]
RewriteRule ^dayton/new-empire/?$ dayton/new-empire/index.php [L]
RewriteRule ^dayton/sutro-heights/?$ dayton/sutro-heights/index.php [L]
RewriteRule ^dayton/riverpark/?$ dayton/riverpark/index.php [L]
RewriteRule ^dayton/?$ dayton/index.php [L]
RewriteRule ^washoe-valley/?$ washoe-valley/index.php [L]
RewriteRule ^incline-village/?$ incline-village/index.php [L]
RewriteRule ^spanish-springs/?$ spanish-springs/index.php [L]
RewriteRule ^verdi/?$ verdi/index.php [L]
RewriteRule ^fernley/?$ fernley/index.php [L]
RewriteRule ^yerington/?$ yerington/index.php [L]
RewriteRule ^smith-valley/?$ smith-valley/index.php [L]
